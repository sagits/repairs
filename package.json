{
  "name": "repairs",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "turbo run dev --filter @repairs/both",
    "build": "turbo run build",
    "build:web": "turbo run build:web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check:apps": "node scripts/check-app-parity.mjs",
    "test": "turbo run test",
    "e2e:build": "turbo run e2e:build --concurrency 1",
    "e2e:test": "turbo run e2e:test --concurrency 1"
  },
  "devDependencies": {
    "turbo": "^2.6.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
