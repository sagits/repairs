{
  "extends": "@repairs/config/tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "expo-router": ["./node_modules/expo-router"],
      "expo-router/*": ["./node_modules/expo-router/*"]
    }
  },
  "include": [
    "app",
    "e2e",
    "*.ts",
    "*.tsx",
    "*.d.ts",
    ".expo/types/**/*.ts",
    "../../packages/*/src",
    "nativewind-env.d.ts",
    "expo-env.d.ts"
  ]
}
