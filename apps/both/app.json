{
  "expo": {
    "name": "Repairs",
    "slug": "repairs",
    "scheme": "repairs",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.renatoprobst.repairs",
      "supportsTablet": true
    },
    "android": {
      "package": "com.renatoprobst.repairs"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
